# Narra Studio local configuration template.
# Copy to .env. Keep real credentials only in .env; never commit that file.
# Google passwords, cookies and 2FA secrets never belong in environment files.

NARRA_STORAGE_ROOT=
NARRA_WORKSPACE_ROOT=
NARRA_DATABASE_ROOT=
NARRA_VOICE_RUNTIME_ROOT=
NARRA_VOICE_PYTHON=
NARRA_FLOW_ACCOUNT_SLOTS=5
GENYU_DEPTH_THREADS=2
GENYU_DEPTH_COREML=1
GENYU_DEPTH_COREML_FLAGS=0
ORT_LOGGING_LEVEL=3
