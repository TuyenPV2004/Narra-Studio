# Narra Studio runs locally. Copy this file to .env and fill only providers you use.
# Never commit .env. Google passwords, cookies and 2FA secrets never belong here.

# Google Flow automation keeps login state in isolated local Electron sessions.
# No Google password, cookie or 2FA secret belongs in this file.
GOOGLE_FLOW_API_KEY=

# Optional Avis provider. Media generation calls Avis only after user action.
AVIS_API_BASE=https://api.avis.xyz/api/openai/v1
AVIS_API_KEY=

# Optional OpenAI-compatible/Ollama text fallback used by the recovered agent runtime.
OLLAMA_API_BASE=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5-2

# Optional Cloudflare intermediary for Avis reference-media workflows.
# Leave empty when the selected Avis flow accepts local/direct inputs.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Optional voice/lip-sync providers.
ITERA102_API_KEY=
SYNC_API_KEY=
