# Narra Studio V1 runs without external APIs by default.
# Copy this file to .env only when an optional provider is explicitly enabled.

# Optional location for local documentary projects. Empty uses the app default.
NARRA_PROJECTS_DIR=

# Optional ElevenLabs adapter (manual web import remains the V1 default).
ELEVENLABS_API_KEY=

# Optional YouTube private-upload adapter (manual upload remains supported).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

